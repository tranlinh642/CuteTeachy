{
  "name": "CuteTeachy-FE",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "web": "pnpm --filter web dev",
    "mobile": "pnpm --filter mobile start"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.5",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22.13"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.28.2"
    }
  }
}
