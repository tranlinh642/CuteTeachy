{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Source-only workspace library (consumed directly by Next.js / Metro bundlers)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": true
  }
}
